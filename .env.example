# Database
POSTGRES_DB=urbano_homes
POSTGRES_USER=urbano
POSTGRES_PASSWORD=change_me
DB_HOST=postgres
DB_PASSWORD=change_me

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# JWT
JWT_SECRET=change_me_to_a_long_random_string

# Service URLs (Docker network names)
AUTH_SERVICE_URL=http://auth-service:8081
PROPERTY_SERVICE_URL=http://property-service:8082
LISTING_SERVICE_URL=http://listing-service:8083
TENANT_SERVICE_URL=http://tenant-service:8084
PAYMENT_SERVICE_URL=http://payment-service:8085
MAINTENANCE_SERVICE_URL=http://maintenance-service:8086
CRM_SERVICE_URL=http://crm-service:8087

# Spring
SPRING_PROFILES_ACTIVE=docker

# MinIO
MINIO_ROOT_USER=change_me
MINIO_ROOT_PASSWORD=change_me

# M-Pesa (Daraja)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_ENVIRONMENT=sandbox
MPESA_CALLBACK_URL=http://gateway:8080/api/callbacks/daraja

# Email
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_SSL_TRUST=*

# Twilio/SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Reports
REPORT_STORAGE_PATH=/tmp/reports

# Africa's Talking
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=URBANO
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=URBANO
SMS_PROVIDER=africastalking

# Health check
MANAGEMENT_HEALTH_MAIL_ENABLED=false
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
