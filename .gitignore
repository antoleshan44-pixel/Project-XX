$dockerignore = @"
**/target/
**/*.jar
**/*.war
**/*.ear
**/*.class

**/.idea/
**/*.iml
**/.vscode/
**/.run/
**/*.swp
**/*.swo
**/*~

**/.git/
**/.gitignore
**/.gitattributes

.env
.env.*
**/.env
**/.env.*

**/*.log
**/logs/

docker-compose.yml
**/postgres_data/
**/minio_data/
**/report_data/

**/.DS_Store
**/Thumbs.db

structure.txt
README.md
*.bak
*.bak.*
*.bak2

test_report.json
test_debug.log
**/__pycache__/
**/*.pyc
"@
[System.IO.File]::WriteAllText("$PWD\.dockerignore", $dockerignore)