# =============================================================================
# .gitignore
# =============================================================================

# --- Build outputs ---------------------------------------------------------
target/
build/
out/
*.jar
*.war
*.ear
*.class

# --- IDE / Editor ---------------------------------------------------------
.idea/
*.iml
.vscode/
.run/
*.swp
*.swo
*~

# --- Secrets / local env (CRITICAL — never commit these) -------------------
.env
.env.*
*.env
**/application-local.yml
**/application-*-local.yml
**/local.ps1

# --- Logs & temp ----------------------------------------------------------
*.log
logs/
tmp/

# --- Local infrastructure data --------------------------------------------
postgres_data/
minio_data/
report_data/

# --- OS cruft -------------------------------------------------------------
.DS_Store
Thumbs.db
*.lnk

# --- Repo docs & scratch files --------------------------------------------
structure.txt
*.bak
*.bak.*
*.bak2
test_report.json
test_debug.log
__pycache__/
*.pyc
