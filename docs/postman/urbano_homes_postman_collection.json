						"body": {
							"mode": "raw",
							"raw": "{\n  \"propertyId\": \"{{propertyId}}\",\n  \"unitNumber\": \"B204\",\n  \"floor\": 2,\n  \"bedrooms\": 2,\n  \"bathrooms\": 2,\n  \"rentAmount\": 50000.00,\n  \"currency\": \"KES\",\n  \"propertyType\": \"APARTMENT\",\n  \"transactionType\": \"FOR_RENT\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/units",
							"host": ["{{baseUrl}}"],
							"path": ["api", "units"]
						}
					}
