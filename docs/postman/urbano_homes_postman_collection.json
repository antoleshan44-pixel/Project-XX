					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"phone\": \"+254700000000\",\n  \"code\": \"123456\",\n  \"newPassword\": \"TenantPass123!\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/tenant/activate",
							"host": ["{{baseUrl}}"],
							"path": ["api", "auth", "tenant", "activate"]
						}
