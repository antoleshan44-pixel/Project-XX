								"value": "Bearer {{authToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/auth/me",
							"host": ["{{baseUrl}}"],
							"path": ["api", "auth", "me"]
						}
					}
				}
			]
		},
		{
			"name": "2. Public Portal",
			"item": [
				{
					"name": "Get Public Listings",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/public/listings?location=Nairobi&bedrooms=2&transactionType=FOR_RENT",
							"host": ["{{baseUrl}}"],
							"path": ["api", "public", "listings"],
							"query": [
								{ "key": "location", "value": "Nairobi" },
								{ "key": "bedrooms", "value": "2" },
								{ "key": "transactionType", "value": "FOR_RENT" }
							]
						}
					}
				},
				{
					"name": "Inquire About Listing",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"John Buyer\",\n  \"email\": \"john@gmail.com\",\n  \"phone\": \"+254722000000\",\n  \"message\": \"Is this unit available for viewing this Saturday?\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/public/listings/{{listingId}}/inquire",
							"host": ["{{baseUrl}}"],
							"path": ["api", "public", "listings", "{{listingId}}", "inquire"]
