						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Kilimani Heights\",\n  \"address\": \"Ring Road Kilimani\",\n  \"city\": \"Nairobi\",\n  \"type\": \"RESIDENTIAL\",\n  \"totalUnits\": 20,\n  \"ownerId\": \"3fa85f64-5717-4562-b3fc-2c963f66afa6\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/properties",
							"host": ["{{baseUrl}}"],
							"path": ["api", "properties"]
						}
					}
				},
